#!/bin/sh /etc/rc.common
# Local research service. Installing this file does not enable VPN login.
START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled server device tun lan network data spa spa_user ca targets credentials
	config_load campusvpn
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get server main server https://myvpn.ahau.edu.cn
	config_get device main device_id
	config_get tun main tun cvpn0
	config_get lan main lan_source
	config_get targets main resource_target
	config_get credentials main credential_file
	config_get network main network_profile none
	config_get data main data_profile android
	config_get spa main spa_profile school-apk
	config_get spa_user main spa_user enlink
	config_get ca main ca_file
	[ -n "$device" ] || { logger -t campusvpn 'Set a stable random device_id before starting the service'; return 1; }
	procd_open_instance main
	procd_set_param command /usr/sbin/campusvpn -mode serve -server "$server" -device-id "$device" -tun "$tun" -network-profile "$network" -data-profile "$data" -spa-profile "$spa" -spa-user "$spa_user"
	[ -z "$lan" ] || procd_append_param command -lan-source "$lan"
	[ -z "$targets" ] || procd_append_param command -resource-target "$targets"
	[ -z "$credentials" ] || procd_append_param command -credential-file "$credentials"
	[ -z "$ca" ] || procd_append_param command -ca "$ca"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 50
	procd_set_param limits core=0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/campusvpn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger campusvpn
}
