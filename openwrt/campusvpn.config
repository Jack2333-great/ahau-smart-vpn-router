config campusvpn 'main'
	option enabled '0'
	option server 'https://myvpn.ahau.edu.cn'
	option device_id ''
	option tun 'cvpn0'
	option network_profile 'none'
	option data_profile 'android'
	option spa_profile 'school-apk'
	option spa_user 'enlink'
	option lan_source ''
	option resource_target ''
	option credential_file ''
	option ca_file ''

# No username/password/session/cookie options. Login is interactive after boot.
# Do not enable dorm-router until the real account's resource list is reviewed.
